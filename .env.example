# Production requires HTTPS, stable secret and a Railway persistent volume.
APP_ENV=development
BASE_URL=http://127.0.0.1:8010
SESSION_SECRET=
DATABASE_PATH=./data/dapsol.db
LOCAL_AUTH_ENABLED=true
# Registered redirects: BASE_URL/auth/google/callback, /auth/naver/callback, /auth/kakao/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
